  «text (2200,-10350) 1.4 7 1 0x1000000 -1 -1 "ï»¿SIMULATION"Â»
  «text (2200,-10600) 1 7 1 0x1000000 -1 -1 "ï»¿Models (PV module, coupled inductor, MOSFET estimate, driver, sensor, trace lump) come from shuffler_models.lib"Â»
  «text (2200,-10750) 1 7 1 0x1000000 -1 -1 "ï»¿via the symbols' library attribute - keep that file next to this schematic; edit it to swap in the Qspice FET-modeller MOSFET."Â»
  «text (2200,-10950) 1 7 0 0x1000000 -1 -1 "ï»¿.option savepowers"Â»
  «text (4800,-10950) 1 7 1 0x1000000 -1 -1 "ï»¿P(name) traces for every element (MOSFET losses)"Â»
  «text (2200,-11100) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 0 2.5m 2.45m 10n"Â»
  «text (4800,-11100) 1 7 1 0x1000000 -1 -1 "ï»¿2.5 ms run, the last 50 us saved with <= 10 ns steps; the modules and 130 uF caps settle in ~1 ms"Â»
  «text (2200,-11250) 1 7 0 0x1000000 -1 -1 "ï»¿.step param CASE list 1 2 3"Â»
  «text (4800,-11250) 1 7 1 0x1000000 -1 -1 "ï»¿irradiance patterns (see E1..E3 sources)"Â»
  «text (2200,-11400) 1 7 0 0x1000000 -1 -1 "ï»¿.step param LOADSEL list 0 1"Â»
  «text (4800,-11400) 1 7 1 0x1000000 -1 -1 "ï»¿resistor load, then current sink"Â»
  «text (2200,-11650) 1 7 1 0x1000000 -1 -1 "ï»¿Snubber / HF-cap design sweep: fix CASE and LOADSEL (delete the two .step lines above) and add e.g."Â»
  «text (2200,-11800) 1 7 1 0x1000000 -1 -1 "ï»¿   .step param Csn list 1p 220p 470p 1n 2.2n    and/or    .step param Chf list 1p 100n 470n 1u"Â»
  «text (2200,-11950) 1 7 1 0x1000000 -1 -1 "ï»¿Waveforms worth plotting: V(SWA1,B1) switch node, V(gTA1,SWA1) gate, I(VsA1) I(VsB1) inductor currents,"Â»
  «text (2200,-12100) 1 7 1 0x1000000 -1 -1 "ï»¿   I(Vi1) I(Vi2) I(Vi3) module currents, V(BOOTA1,SWA1) bootstrap, P(MTA1) FET loss, I(Bload)*V(PV1P) string power."Â»
  «text (2200,-12250) 1 7 1 0x1000000 -1 -1 "ï»¿Results of the .meas lines appear in the QPOST output after the run (or run PCB_Baseline/run_baseline.py)."Â»
  «text (9600,-10350) 1.4 7 1 0x1000000 -1 -1 "ï»¿MEASUREMENTS - averages / extremes over the saved window, one value per step"Â»
  «text (9600,-10600) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vstr AVG V(PV1P)"Â»
  «text (9600,-10750) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran istr AVG I(Bload)"Â»
  «text (9600,-10900) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran pout AVG V(PV1P)*I(Bload)"Â»
