  «text (-4400,-14290) 1 7 1 0x1000000 -1 -1 "ï»¿TMCS1126 conductor inductance"Â»
  «text (-7000,-14520) 1 7 1 0x1000000 -1 -1 "ï»¿* Placeholder footprints (1 pF / 4.7 R = not fitted)"Â»
  «text (-7000,-14670) 1 7 0 0x1000000 -1 -1 "ï»¿.param Csn=1p"Â»
  «text (-4400,-14670) 1 7 1 0x1000000 -1 -1 "ï»¿RC snubber C across each FET (C73-C84 positions); 1p = footprint not fitted, sweep to size it"Â»
  «text (-7000,-14820) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rsn=4.7"Â»
  «text (-4400,-14820) 1 7 1 0x1000000 -1 -1 "ï»¿RC snubber R (R49-R52 positions); only matters once Csn is real"Â»
  «text (-7000,-14970) 1 7 0 0x1000000 -1 -1 "ï»¿.param Chf=1p"Â»
  «text (-4400,-14970) 1 7 1 0x1000000 -1 -1 "ï»¿HF decoupling per capacitor, 3 in parallel per converter rail (C91-C96); 1p = not fitted"Â»
  «text (-7000,-15200) 1 7 1 0x1000000 -1 -1 "ï»¿* Board copper lumps from pcb_parasitics.py: rails T/M/B, switch nodes SWA/SWB, inductor-to-sensor LA/LB, gates g.. (0.5 x free-space inductance)"Â»
