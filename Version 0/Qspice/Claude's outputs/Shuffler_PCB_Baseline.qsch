  «text (-7000,-10350) 1.4 7 1 0x1000000 -1 -1 "ï»¿PARAMETERS - edit values here (units: m = milli, u = micro, n = nano, p = pico)"Â»
  «text (-7000,-10600) 1 7 1 0x1000000 -1 -1 "ï»¿* Switching and gate drive"Â»
  «text (-7000,-10750) 1 7 0 0x1000000 -1 -1 "ï»¿.param Tsw=5u"Â»
  «text (-4400,-10750) 1 7 1 0x1000000 -1 -1 "ï»¿switching period (5 us = 200 kHz)"Â»
  «text (-7000,-10900) 1 7 0 0x1000000 -1 -1 "ï»¿.param Tdead=200n"Â»
  «text (-4400,-10900) 1 7 1 0x1000000 -1 -1 "ï»¿dead time between the two FETs of a leg"Â»
  «text (-7000,-11050) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vlogic=3.3"Â»
  «text (-4400,-11050) 1 7 1 0x1000000 -1 -1 "ï»¿PWM logic level (NUCLEO)"Â»
  «text (-7000,-11200) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vreg=12"Â»
  «text (-4400,-11200) 1 7 1 0x1000000 -1 -1 "ï»¿gate-drive rail from the Wurth 173951275 module (ideal source)"Â»
  «text (-7000,-11350) 1 7 0 0x1000000 -1 -1 "ï»¿.param Ron=10"Â»
  «text (-4400,-11350) 1 7 1 0x1000000 -1 -1 "ï»¿driver OUTH (source) path resistor, KOA SG73S 10R"Â»
  «text (-7000,-11500) 1 7 0 0x1000000 -1 -1 "ï»¿.param Roff=4.7"Â»
  «text (-4400,-11500) 1 7 1 0x1000000 -1 -1 "ï»¿driver OUTL (sink) path resistor, KOA SG73P 4R7"Â»
  «text (-7000,-11650) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rboot=10"Â»
  «text (-4400,-11650) 1 7 1 0x1000000 -1 -1 "ï»¿bootstrap series resistor"Â»
  «text (-7000,-11880) 1 7 1 0x1000000 -1 -1 "ï»¿* Bench loads and irradiance case"Â»
  «text (-7000,-12030) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rmpp=8.148"Â»
  «text (-4400,-12030) 1 7 1 0x1000000 -1 -1 "ï»¿resistor load near the 3-module MPP at 1000 W/m2 (ohm)"Â»
  «text (-7000,-12180) 1 7 0 0x1000000 -1 -1 "ï»¿.param Icc=10"Â»
  «text (-4400,-12180) 1 7 1 0x1000000 -1 -1 "ï»¿constant-current bench load (A), ramped up over the first 200 us; keep below ~11 A with one converter"Â»
  «text (-7000,-12330) 1 7 0 0x1000000 -1 -1 "ï»¿.param CASE=1"Â»
  «text (-4400,-12330) 1 7 1 0x1000000 -1 -1 "ï»¿irradiance pattern 1..3 (stepped by the .step line)"Â»
  «text (-7000,-12480) 1 7 0 0x1000000 -1 -1 "ï»¿.param LOADSEL=0"Â»
  «text (-4400,-12480) 1 7 1 0x1000000 -1 -1 "ï»¿0 = resistor load, 1 = current sink (stepped)"Â»
  «text (-7000,-12710) 1 7 1 0x1000000 -1 -1 "ï»¿* Module and cable"Â»
  «text (-7000,-12860) 1 7 0 0x1000000 -1 -1 "ï»¿.param Cpv=10n"Â»
  «text (-4400,-12860) 1 7 1 0x1000000 -1 -1 "ï»¿PV module terminal capacitance (ballpark)"Â»
  «text (-7000,-13010) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rcab=6.95m"Â»
  «text (-4400,-13010) 1 7 1 0x1000000 -1 -1 "ï»¿module cable, one lead: 1.5 m of 4 mm2 + XT60 contact"Â»
  «text (-7000,-13160) 1 7 0 0x1000000 -1 -1 "ï»¿.param Lcab=750n"Â»
  «text (-4400,-13160) 1 7 1 0x1000000 -1 -1 "ï»¿module cable, one lead (about 1 uH/m loop)"Â»
  «text (-7000,-13390) 1 7 1 0x1000000 -1 -1 "ï»¿* Board capacitors, package, sensor"Â»
  «text (-7000,-13540) 1 7 0 0x1000000 -1 -1 "ï»¿.param ESR130=28m"Â»
  «text (-4400,-13540) 1 7 1 0x1000000 -1 -1 "ï»¿TDK B40910A0137M000 130 uF: ESR"Â»
  «text (-7000,-13690) 1 7 0 0x1000000 -1 -1 "ï»¿.param ESL130=15n"Â»
  «text (-4400,-13690) 1 7 1 0x1000000 -1 -1 "ï»¿130 uF radial can: ESL"Â»
  «text (-7000,-13840) 1 7 0 0x1000000 -1 -1 "ï»¿.param Ld_pkg=1.5n"Â»
  «text (-4400,-13840) 1 7 1 0x1000000 -1 -1 "ï»¿TO-252 drain tab inductance"Â»
  «text (-7000,-13990) 1 7 0 0x1000000 -1 -1 "ï»¿.param Ls_pkg=3n"Â»
  «text (-4400,-13990) 1 7 1 0x1000000 -1 -1 "ï»¿TO-252 source lead inductance (common-source)"Â»
  «text (-7000,-14140) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rtmcs=0.7m"Â»
  «text (-4400,-14140) 1 7 1 0x1000000 -1 -1 "ï»¿TMCS1126 conductor resistance"Â»
