{
  "title": "Shuffler pod",
  "uid": "shuffler",
  "schemaVersion": 39,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "influxdb",
        "current": {
          "text": "InfluxDB",
          "value": "InfluxDB"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Mode",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "textMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: -30d) |> filter(fn: (r) => r[\"_measurement\"] == \"pod\") |> filter(fn: (r) => r[\"_field\"] == \"mode\") |> last() |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active (S1 top / S2 bottom / switching / fault / Nucleo link)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 10,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "☐ OFF",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "☑ ON",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "displayName": "${__field.labels._field}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fault_active"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "☐ no fault",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "☑ FAULT",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link_ok"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NO LINK",
                        "color": "purple",
                        "index": 0
                      },
                      "1": {
                        "text": "link ok",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: -30d) |> filter(fn: (r) => r[\"_measurement\"] == \"pod\") |> filter(fn: (r) => r[\"_field\"] == \"s2_active\" or r[\"_field\"] == \"s1_active\" or r[\"_field\"] == \"switching\" or r[\"_field\"] == \"fault_active\" or r[\"_field\"] == \"link_ok\") |> last() |> keep(columns: [\"_field\", \"_value\"])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Init check (last C,TEST,0)",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "PASS",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "displayName": "${__field.labels._field}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: -30d) |> filter(fn: (r) => r[\"_measurement\"] == \"init\") |> filter(fn: (r) => r[\"_field\"] != \"fails\") |> last() |> keep(columns: [\"_field\", \"_value\"])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heatsink / INA die temperature",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"heatsink_c\" or r[\"_field\"] == \"T1\" or r[\"_field\"] == \"T2\" or r[\"_field\"] == \"T3\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "State",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"state_code\" or r[\"_field\"] == \"fault\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Module voltages",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"VM1\" or r[\"_field\"] == \"VM2\" or r[\"_field\"] == \"VM3\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inductor currents",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"ILA1\" or r[\"_field\"] == \"ILB1\" or r[\"_field\"] == \"ILA2\" or r[\"_field\"] == \"ILB2\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duties",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"dA1\" or r[\"_field\"] == \"dB1\" or r[\"_field\"] == \"dA2\" or r[\"_field\"] == \"dB2\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Supervisor",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"rv1\" or r[\"_field\"] == \"rv2\" or r[\"_field\"] == \"beta\" or r[\"_field\"] == \"stress\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconstructed module currents (rel. to module 3)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"IM1r\" or r[\"_field\"] == \"IM2r\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "String voltage",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"shuffler\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"Vstr\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    }
  ]
}