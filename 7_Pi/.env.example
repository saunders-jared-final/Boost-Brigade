# Copy to 7_Pi/.env (gitignored) and change every value before `docker compose up -d`.
# Docker Compose reads this file automatically; pod.py and the tools read INFLUX_TOKEN from the
# environment or from this file. Rotate these on the physical pod: the previous defaults were public.
INFLUX_PASSWORD=change-me
INFLUX_TOKEN=change-me-long-random-token
GRAFANA_PASSWORD=change-me
