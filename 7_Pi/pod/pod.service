[Unit]
Description=Shuffler pod (Nucleo telemetry bridge, UI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@PI_DIR@/pod
ExecStart=@PI_DIR@/.venv/bin/python @PI_DIR@/pod/pod.py --port /dev/ttyACM0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
