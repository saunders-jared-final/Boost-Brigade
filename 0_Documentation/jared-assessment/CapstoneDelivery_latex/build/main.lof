\contentsline {figure}{\numberline {1}{\ignorespaces Existing partial-shading mitigation and converter-control strategies reviewed (figures reproduced from the cited works).\relax }}{4}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Why partial shading defeats a string MPPT: Simulink sweep of a two-module string with 1000 and 200\,W/m$^2$ irradiance; the bypass diode creates a second local maximum and the weakest module sets the string current (MIL PV model, Semester 1).\relax }}{4}{figure.caption.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Controller design pipeline mapped onto the systems-engineering V-model. Dashed links are the verification pairs used in \cref {sec:synthesis}.\relax }}{6}{figure.caption.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces One interleaved buck-boost power shuffler between two series PV modules (phase A and phase B half-bridges on a coupled inductor; $C_1$, $C_2$ decouple the modules from the string).\relax }}{7}{figure.caption.5}%
\contentsline {figure}{\numberline {5}{\ignorespaces The $N$-module problem. Key physical parameters: $L\pm M$ (winding inductance in each mode), $R_m$, $R_c$ (mode resistances incl.\ the switching loss $R_{sw}$), $C_k$ (module decoupling), $G_{load}$ (CV load conductance).\relax }}{7}{figure.caption.6}%
\contentsline {figure}{\numberline {6}{\ignorespaces Open-loop phase portraits of the voltage mode in the $(\ensuremath {v_{d}},\,Z_0\ensuremath {i_{m}})$ plane: (a) 2026 App.\nobreakspace {}B copper-only model ($\zeta \approx 0.07$), (b) PV80 plant with the 61\,m$\Omega $ averaged resistance (focus, $\zeta \approx 0.3$, 7--9\,kHz), (c) 0.29\,$\Omega $ switching plant at 200\,kHz and (d) 1.7\,$\Omega $ at 400\,kHz (over-damped nodes). The plant damps itself once the real switching resistance is included.\relax }}{8}{figure.caption.7}%
\contentsline {figure}{\numberline {7}{\ignorespaces Simulink MIL model (\texttt {4\_Simulink/1\_MIL\_Model\_In\_The\_Loop}).\relax }}{9}{figure.caption.8}%
\contentsline {figure}{\numberline {8}{\ignorespaces System architecture and data flow: the Pi pod is the user interface, logger and flasher; the Nucleo closes the loop; the PCB carries the power stage and sensors.\relax }}{10}{figure.caption.9}%
\contentsline {figure}{\numberline {9}{\ignorespaces Controller selection and routing (microcontroller NUCLEO-G474RE \cite {mb1367_schematic}, hall sensor TMCS1126 \cite {tmcs1126_ds}, power monitor INA239 \cite {ina239_ds}, microcomputer Raspberry Pi 4B \cite {rpi4_datasheet}).\relax }}{10}{figure.caption.10}%
\contentsline {figure}{\numberline {10}{\ignorespaces Gain pipeline: identification in Simulink or QSPICE $\rightarrow $ \texttt {shuffler\_params.json} $\rightarrow $ \texttt {params.h} $\rightarrow $ the same C core in SIL, the QSPICE DLL and the firmware.\relax }}{11}{figure.caption.12}%
\contentsline {figure}{\numberline {11}{\ignorespaces The two identification plants: the Simulink carpark twin (averaged switches, 61\,m$\Omega $) and the QSPICE integrated model (real switches, drivers, dead time, hall and INA sensing models).\relax }}{12}{figure.caption.13}%
