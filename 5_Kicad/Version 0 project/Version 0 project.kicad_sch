		(uuid "0edc38d7-3f9f-42e1-abaa-235ac63a57a0")
	)
	(text "Note: to ensure compatibility with multiboard designs, \ntrue 3v3 rail (referenced to ground) must be provided on \nthe subsequent board to provide ground reference to hall\neffect sensors and mosfet drivers. \n\nGround rail also to be provided to subsequent board to \nensure common references for control signals\n\nAlternatively, run 1 nucleo per board\n\n"
		(exclude_from_sim no)
		(at 209.55 102.616 0)
		(effects
