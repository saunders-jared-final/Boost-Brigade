---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE, NAV, href } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Force a theme for this page ('dark' for the landing page). */
  theme?: 'light' | 'dark' | 'auto';
  ogImage?: string;
}
const { title, description = SITE.description, theme = 'auto', ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const og = ogImage ?? href('/og.jpg');
---
<!doctype html>
<html lang="en" data-theme={theme === 'auto' ? undefined : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply the stored theme before paint (only when the page does not force one).
      (function () {
        try {
          var forced = document.documentElement.getAttribute('data-theme');
          if (forced) return;
          var t = localStorage.getItem('bb-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={href('/')}><span class="dot" aria-hidden="true"></span>{SITE.shortTitle}</a>
        <nav class="nav-links" id="nav-links" aria-label="Primary">
          {NAV.map((n) => (
            <a href={href(n.href)} aria-current={current === n.href || (n.href !== '/' && current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="row" style="gap:.5rem">
          <button class="theme-btn" id="theme-btn" type="button" aria-label="Toggle colour theme" title="Toggle theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
          </button>
          <button class="theme-btn nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-id">
            <a class="brand" href={href('/')}><span class="dot" aria-hidden="true"></span>Boost Brigade</a>
            <p>QUT EGH490 Research Project, 2026. Power electronics by Son Nguyen, control systems by Jared Saunders, supervised by Assoc Prof Geoff Walker.</p>
          </div>
          <ul class="footer-links">
            <li><a href={SITE.repo} target="_blank" rel="noopener">GitHub repository</a></li>
            <li><a href={href('/handover/#downloads')}>Reports and downloads</a></li>
            <li><a href={`${SITE.repo}/blob/main/SAFETY.md`} target="_blank" rel="noopener">Ratings and safety notes</a></li>
            <li><a href={`${SITE.repo}/blob/main/LICENSE.md`} target="_blank" rel="noopener">Licence</a></li>
          </ul>
        </div>
        <p class="footer-safety"><strong>Safety:</strong> the board is an unverified student prototype that operates at hazardous DC voltages. Everything here is provided as is, without warranty or liability.</p>
        <div class="footer-base">
          <p><span class="fb-h">Built with</span> <a href={SITE.qspice} target="_blank" rel="noopener">QSPICE</a> · <a href={SITE.kicad} target="_blank" rel="noopener">KiCad 10</a> · <a href="https://www.mathworks.com/products/simulink.html" target="_blank" rel="noopener">MATLAB / Simulink</a> · <a href="https://www.autodesk.com/products/fusion-360" target="_blank" rel="noopener">Fusion 360</a> · <a href="https://grafana.com/" target="_blank" rel="noopener">Grafana + InfluxDB</a></p>
          <p>PCB © Son Nguyen and enclosure © Jared Saunders, under <a href="https://ohwr.org/cern_ohl_s_v2.txt" target="_blank" rel="noopener license">CERN-OHL-S-2.0</a>. Analytical work, controller structure and documentation © Jared Saunders, under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener license">CC BY 4.0</a>. Code under MIT.</p>
        </div>
      </div>
    </footer>

    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';
      import 'photoswipe/style.css';
      const btn = document.getElementById('theme-btn');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const cur = root.getAttribute('data-theme') || (sysDark ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('bb-theme', next); } catch {}
      });
      const tog = document.getElementById('nav-toggle');
      const links = document.getElementById('nav-links');
      tog?.addEventListener('click', () => {
        const open = links?.classList.toggle('open');
        tog.setAttribute('aria-expanded', String(!!open));
      });
      // scroll reveal
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // copy buttons
      document.querySelectorAll<HTMLButtonElement>('.kbd-copy button').forEach((b) => {
        b.addEventListener('click', async () => {
          const pre = b.parentElement?.querySelector('pre');
          if (!pre) return;
          try { await navigator.clipboard.writeText(pre.innerText); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1200); } catch {}
        });
      });
      // lightbox for every zoomable figure on the page
      if (document.querySelector('a.zoomable')) {
        const lb = new PhotoSwipeLightbox({ gallery: 'body', children: 'a.zoomable', pswpModule: () => import('photoswipe'), bgOpacity: .92, padding: { top: 24, bottom: 24, left: 16, right: 16 } });
        lb.on('uiRegister', () => {
          lb.pswp?.ui?.registerElement({ name: 'caption', order: 9, isButton: false, appendTo: 'root', onInit: (el, pswp) => {
            pswp.on('change', () => { const cap = pswp.currSlide?.data.element?.closest('figure')?.querySelector('figcaption'); el.innerHTML = cap ? cap.innerHTML : ''; });
          } });
        });
        lb.init();
      }
    </script>
    <style is:global>
      .pswp [class*="caption"] { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,.65); color: #fff; padding: .4rem .8rem; border-radius: 8px; font-size: .9rem; max-width: 90%; text-align: center; }
      .pswp [class*="caption"] a { color: #ffd27a; }
    </style>
  </body>
</html>
