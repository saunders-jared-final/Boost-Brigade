---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE, NAV, href } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Force a theme for this page ('dark' for the landing page). */
  theme?: 'light' | 'dark' | 'auto';
  ogImage?: string;
  wide?: boolean;
}
const { title, description = SITE.description, theme = 'auto', ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const og = ogImage ?? href('/og.jpg');
---
<!doctype html>
<html lang="en" data-theme={theme === 'auto' ? undefined : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply the stored theme before paint (only when the page does not force one).
      (function () {
        try {
          var forced = document.documentElement.getAttribute('data-theme');
          if (forced) return;
          var t = localStorage.getItem('bb-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={href('/')}><span class="dot" aria-hidden="true"></span>{SITE.shortTitle}</a>
        <nav class="nav-links" id="nav-links" aria-label="Primary">
          {NAV.map((n) => (
            <a href={href(n.href)} aria-current={current === n.href || (n.href !== '/' && current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="row" style="gap:.5rem">
          <button class="theme-btn" id="theme-btn" type="button" aria-label="Toggle colour theme" title="Toggle theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
          </button>
          <button class="theme-btn nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <h4>Project</h4>
          <ul>
            <li><a href={SITE.repo} target="_blank" rel="noopener">GitHub repository</a></li>
            <li><a href={href('/handover/')}>Handover for the next team</a></li>
            <li><a href={href('/about/')}>Team and downloads</a></li>
          </ul>
        </div>
        <div>
          <h4>Tools used</h4>
          <ul>
            <li><a href={SITE.qspice} target="_blank" rel="noopener">QSPICE (free download)</a></li>
            <li><a href={SITE.kicad} target="_blank" rel="noopener">KiCad 10</a></li>
            <li><a href="https://www.mathworks.com/products/simulink.html" target="_blank" rel="noopener">MATLAB / Simulink</a></li>
            <li><a href="https://grafana.com/" target="_blank" rel="noopener">Grafana + InfluxDB</a></li>
          </ul>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            {NAV.slice(1).map((n) => <li><a href={href(n.href)}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <p class="small">QUT EGH490 Research Project, 2026. Control stream by Jared Saunders, hardware stream by Son Nguyen, supervised by Assoc Prof Geoff Walker.</p>
          <p class="small">Every number on this site links to the figure, table or file it comes from.</p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-btn');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const cur = root.getAttribute('data-theme') || (sysDark ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('bb-theme', next); } catch {}
      });
      const tog = document.getElementById('nav-toggle');
      const links = document.getElementById('nav-links');
      tog?.addEventListener('click', () => {
        const open = links?.classList.toggle('open');
        tog.setAttribute('aria-expanded', String(!!open));
      });
      // scroll reveal
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // copy buttons
      document.querySelectorAll<HTMLButtonElement>('.kbd-copy button').forEach((b) => {
        b.addEventListener('click', async () => {
          const pre = b.parentElement?.querySelector('pre');
          if (!pre) return;
          try { await navigator.clipboard.writeText(pre.innerText); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1200); } catch {}
        });
      });
    </script>
  </body>
</html>
