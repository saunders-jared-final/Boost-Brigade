---
/**
 * Lazy YouTube embed (lite-youtube-embed). Without an id it plays `mp4` (a direct video URL)
 * if given, else renders a placeholder card.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
interface Props { id?: string; title: string; note?: string; params?: string; mp4?: string; poster?: ImageMetadata; }
const { id, title, note, params = 'rel=0&modestbranding=1', mp4, poster } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, width: 1280, format: 'webp' })).src : undefined;
---
<figure class="yt figure">
  {id ? (
    <lite-youtube videoid={id} playlabel={`Play: ${title}`} params={params} style="border-radius:12px;overflow:hidden;border:1px solid var(--line)"></lite-youtube>
  ) : mp4 ? (
    <video controls preload="none" poster={posterUrl} playsinline style="width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;border:1px solid var(--line)" title={title}>
      <source src={mp4} type="video/mp4" />
      Your browser cannot play this video. <a href={mp4}>Download it</a> instead.
    </video>
  ) : (
    <div class="yt-placeholder" role="img" aria-label={`Video placeholder: ${title}`}>
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
      <strong>{title}</strong>
      <span class="small muted">Video coming soon</span>
    </div>
  )}
  {(note) && <figcaption>{note}</figcaption>}
</figure>
<script>
  import 'lite-youtube-embed/src/lite-yt-embed.css';
  import 'lite-youtube-embed';
</script>
<style>
  .yt-placeholder { aspect-ratio: 16 / 9; border: 1px dashed var(--line); border-radius: 12px; display: grid; place-content: center; justify-items: center; gap: .4rem; background: var(--bg-2); color: var(--muted); text-align: center; padding: 1rem; }
  .yt-placeholder strong { color: var(--text); }
</style>
