---
/** Before/after slider (img-comparison-slider web component). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: ImageMetadata; after: ImageMetadata; beforeLabel?: string; afterLabel?: string; alt: string; caption?: string; }
const { before, after, beforeLabel = 'Before', afterLabel = 'After', alt, caption } = Astro.props;
---
<figure class="figure compare">
  <img-comparison-slider>
    <figure slot="first" class="cmp-pane"><Image src={before} alt={`${alt} (${beforeLabel})`} width={1400} /><figcaption>{beforeLabel}</figcaption></figure>
    <figure slot="second" class="cmp-pane"><Image src={after} alt={`${alt} (${afterLabel})`} width={1400} /><figcaption>{afterLabel}</figcaption></figure>
  </img-comparison-slider>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
  import 'img-comparison-slider';
</script>
<style>
  .compare img-comparison-slider { width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); --divider-width: 2px; --divider-color: var(--accent); --default-handle-color: var(--accent); --default-handle-opacity: .95; }
  .cmp-pane { margin: 0; position: relative; }
  .cmp-pane img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 0; border-radius: 0; }
  .cmp-pane figcaption { position: absolute; bottom: .6rem; left: .6rem; background: rgba(0,0,0,.6); color: #fff; font-size: .75rem; padding: .2rem .55rem; border-radius: 999px; font-family: var(--font-mono); margin: 0; }
  .cmp-pane[slot="second"] figcaption { left: auto; right: .6rem; }
</style>
