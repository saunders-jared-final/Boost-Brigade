---
interface Props { value: string; label: string; evidence?: string; href?: string; }
const { value, label, evidence, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="stat reveal" href={href}>
  <div class="value">{value}</div>
  <div class="label">{label}</div>
  {evidence && <div class="evidence">↳ {evidence}</div>}
</Tag>
