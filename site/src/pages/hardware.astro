---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Figure from '../components/Figure.astro';
import Diagram from '../components/Diagram.astro';
import Callout from '../components/Callout.astro';
import ModelView from '../components/ModelView.astro';
import Exploded from '../components/Exploded';
import { BOARD_PARTS, ENCLOSURE_PARTS } from '../data/parts';
import { photo, fig } from '../lib/assets';
import { href, repoUrl, repoDir, rawUrl } from '../lib/site';
import { existsSync } from 'node:fs';
import path from 'node:path';

const hasBoard = existsSync(path.resolve(process.cwd(), 'public/models/board.glb'));
const hasEnclosure = existsSync(path.resolve(process.cwd(), 'public/models/enclosure.glb'));
const render = fig('misc/hero_render') ?? fig('slides/page-01');
const board = photo('20261004_162523');
const pod = photo('20261011_101108');
const u10 = photo('20261014_164518');

const parts = [
  { ref: 'Nucleo-G474RE', what: 'STM32G474 controller: HRTIM PWM, 10 kHz control tick, telemetry', ds: 'https://www.st.com/en/evaluation-tools/nucleo-g474re.html', sheet: 'Shuffle_Converter' },
  { ref: 'ERUC23 (L1, L2)', what: 'TDK coupled inductor, one per shuffler; L+M = 13.75 µH, leakage 2.05 µH', ds: 'https://product.tdk.com/en/search/inductor/inductor/smd/info?part_no=B82559A2233A023', sheet: 'Shuffle_Converter' },
  { ref: '1ED3140 ×8', what: 'Infineon isolated gate drivers; no dead time, no fault pin', ds: 'https://www.infineon.com/cms/en/product/power/gate-driver-ics/1ed3140mc12m/', sheet: 'Gate_Drivers' },
  { ref: 'TMCS1126 ×4', what: 'TI hall-effect current sensors on the four windings', ds: 'https://www.ti.com/product/TMCS1126', sheet: 'Current_Sense' },
  { ref: 'INA229/239 ×3', what: 'TI bus-voltage monitors on SPI3 (shunt inputs shorted); INA229 footprint on the board, INA239 driver in firmware', ds: 'https://www.ti.com/product/INA239', sheet: 'V_Sense' },
  { ref: 'STD45N10F7 ×8', what: 'ST 100 V MOSFETs, two half-bridges per shuffler', ds: 'https://www.st.com/en/power-transistors/std45n10f7.html', sheet: 'Shuffle_Converter' },
  { ref: 'ISO7762 (U13)', what: 'TI digital isolator for the string-potential INA (wired reversed on V0)', ds: 'https://www.ti.com/product/ISO7762', sheet: 'V_Sense' },
  { ref: 'WPME-FDSM 173951275 ×2', what: 'Würth isolated DC-DC modules for bias rails', ds: 'https://www.we-online.com/en/components/products/MAGI3C-FDSM', sheet: 'FLyback' },
  { ref: 'TPS7A4533 ×2', what: 'TI LDOs for the logic and sensing rails', ds: 'https://www.ti.com/product/TPS7A45', sheet: 'FLyback' },
  { ref: 'Raspberry Pi 4B', what: 'Telemetry pod: InfluxDB + Grafana, e-load control, LCD/IR/LED', ds: 'https://www.raspberrypi.com/products/raspberry-pi-4-model-b/', sheet: '' },
];
const leds = [
  { c: '#3b82f6', l: 'blue', m: 'idle and every readable module < 10 V: safe to touch' },
  { c: '#f59e0b', l: 'amber', m: 'idle but live, or voltages unreadable' },
  { c: '#22c55e', l: 'green', m: 'switching' },
  { c: '#ef4444', l: 'red', m: 'fault latched' },
  { c: '#d946ef', l: 'magenta', m: 'no Nucleo link' },
];
---
<Base title="Hardware" description="The Version 0 shuffler board and enclosure in 3D, the sensing chain, the system architecture and links to the KiCad project.">
  <Section eyebrow="Hardware" title="One board, two shufflers, three panels" lede="A six-layer Version 0 PCB carrying two interleaved buck-boost shufflers, four hall current sensors, three INA239 voltage monitors and an STM32G474 Nucleo, in a 3D-printed enclosure with a Raspberry Pi pod." />

  <Section tight>
    <h3 style="margin-bottom:.8rem">The board in 3D</h3>
    <p class="muted small">Exported from the KiCad project with <code>kicad-cli pcb export glb</code>. Drag to orbit, use the slider to explode, click a part to identify it.</p>
    {hasBoard ? (
      <Exploded client:visible src={href('/models/board.glb')} parts={BOARD_PARTS} up="y" />
    ) : (
      <Callout kind="info" title="3D board model pending">The GLB has not been generated yet. Run <code>site/scripts/prep_models.sh</code> (needs KiCad 10 on Windows). Until then, the photo below stands in.</Callout>
    )}
    {board && !hasBoard && <Figure src={board} alt="Assembled Version 0 board" caption="4 Oct 2026: the assembled board with the Nucleo on headers." />}
  </Section>

  <Section tight alt>
    <h3 style="margin-bottom:.8rem">The enclosure assembly</h3>
    <p class="muted small">Fusion 360 assembly: lid, board, heatsink, pod and base.</p>
    {hasEnclosure ? (
      <Exploded client:visible src={href('/models/enclosure.glb')} parts={ENCLOSURE_PARTS} up="y" />
    ) : (
      render && <Figure src={render} alt="Render of the enclosure with the board inside" caption="Fusion 360 render from the final presentation. The interactive assembly appears here once the mesh export is done (see scripts/README_models.md)." evidence={{ label: 'CAD files', href: repoDir('9_Mechanical_Enclosure_CAD') }} />
    )}
  </Section>

  <Section eyebrow="System architecture" title="What talks to what">
    <div class="grid grid-2" style="align-items:start">
      <Diagram name="system_arch" alt="System architecture: Pi, Nucleo, board, e-load and their links" caption="Pi ↔ Nucleo over the ST-LINK virtual COM port; Pi → DL3021 over USB-TMC; Nucleo → gate drivers over HRTIM; sensors into ADC and SPI3." />
      <div class="stack">
        <div class="card"><h3>Pi ↔ Nucleo</h3><p class="muted small">UART 921600 8N1, one ASCII line per message. Nucleo → Pi: <code>T</code> telemetry at 50 Hz, <code>S</code> status, <code>F</code> fault, <code>A</code> answers, <code>P</code> parameters. Pi → Nucleo: <code>C,…</code> commands and a 1 Hz <code>C,PING</code> heartbeat. The Pi is never in the control loop.</p><a class="mono small" href={repoUrl('0_Documentation/telemetry.md')} target="_blank" rel="noopener">telemetry.md ↗</a></div>
        <div class="card"><h3>Nucleo → board</h3><p class="muted small">Eight HRTIM outputs (PA8–PA11 for shuffler 1, PB12–PB15 for shuffler 2), 180° interleave, 200 ns dead time. Four hall channels into ADC1/ADC2 with DMA; three INA239 chip selects on SPI3.</p><a class="mono small" href={repoUrl('6_RTOS/README.md')} target="_blank" rel="noopener">6_RTOS README ↗</a></div>
        <div class="card"><h3>Pi → e-load and database</h3><p class="muted small">Rigol DL3021 in CV mode over USB-TMC at 5 Hz; the string voltage is pushed back to the Nucleo as <code>vstr_pi</code>. pod.py writes everything to InfluxDB; Grafana shows 16 panels.</p><a class="mono small" href={repoUrl('7_Pi/README.md')} target="_blank" rel="noopener">7_Pi README ↗</a></div>
      </div>
    </div>
  </Section>

  <Section alt eyebrow="Sensing" title="How the currents and voltages are measured">
    <div class="grid grid-2">
      <div>
        <Diagram name="adc_timing" alt="ADC sampling timing relative to the PWM period" caption="Hall sampling: 4 triggers per PWM period, 80 samples per channel per 10 kHz tick = the mean over exactly 20 periods (comb filter with nulls at k·f_sw)." />
      </div>
      <div class="stack">
        <Callout kind="warn" title="Module currents are reconstructed">The INA239s read bus voltage only. Module currents come from the winding currents and duties by KCL (<code>shuffler_recon.c</code>); the string current is an unobservable common offset that the supervisor’s deficit term cancels.</Callout>
        <Callout kind="warn" title="U10 is behind a reversed isolator">The top INA239’s ISO7762 is wired backwards, so the panel-1 voltage is taken from the e-load via the Pi. Rework required for closed loop on converter 1 alone.</Callout>
        {u10 && <Figure src={u10} alt="U10, the top INA239, behind the reversed isolator" caption="14 Oct: U10 and its isolator." />}
      </div>
    </div>
  </Section>

  <Section eyebrow="Bill of materials" title="Key parts and where they live">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Part</th><th>Role</th><th>Datasheet</th><th>Schematic sheet</th></tr></thead>
        <tbody>
          {parts.map((p) => (
            <tr><td class="mono small">{p.ref}</td><td>{p.what}</td><td><a href={p.ds} target="_blank" rel="noopener">vendor ↗</a></td><td>{p.sheet && <a class="mono small" href={repoUrl(`5_Kicad/Version 0 project/${p.sheet}.kicad_sch`)} target="_blank" rel="noopener">{p.sheet}.kicad_sch</a>}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="row" style="margin-top:1.2rem">
      <a class="btn" href={repoDir('5_Kicad/Version 0 project')} target="_blank" rel="noopener">KiCad project ↗</a>
      <a class="btn" href={rawUrl('0_Documentation/schematic_ordered_vo.pdf')} target="_blank" rel="noopener">Schematic PDF ↗</a>
      <a class="btn" href={repoDir('5_Kicad/Version 0 project/Gerber Output')} target="_blank" rel="noopener">Gerbers ↗</a>
      <a class="btn" href={repoUrl('5_Kicad/BOM.xlsx')} target="_blank" rel="noopener">BOM.xlsx ↗</a>
      <a class="btn" href={repoDir('9_Mechanical_Enclosure_CAD')} target="_blank" rel="noopener">Enclosure CAD ↗</a>
    </div>
    <p class="small muted">Six copper layers (F, In1–In4, B). Open with KiCad 10 or later; part libraries are project-relative in <code>5_Kicad/libs</code>.</p>
  </Section>

  <Section alt eyebrow="The pod" title="Raspberry Pi: telemetry and operator interface">
    <div class="grid grid-2" style="align-items:start">
      <div>
        {pod && <Figure src={pod} alt="Raspberry Pi pod with LCD, IR receiver and LED" caption="11 Oct: the pod with LCD, IR receiver and RGB status LED." />}
        <h3>LED legend</h3>
        <ul class="leds">
          {leds.map((l) => <li><span class="led" style={`background:${l.c}`}></span><strong>{l.l}</strong> — {l.m}</li>)}
        </ul>
        <p class="small muted">IR remote presets: 0 init check · 1 open loop · 2 closed loop · 3 load on · 4 load off · 5 load remote · 6 load local · 7 gains 30 % · 8 gains 100 % · 9 clear fault. Digit then PLAY; POWER = E-stop.</p>
      </div>
      <div>
        <h3>Pod wiring</h3>
        <iframe src={href('/embeds/ui-pod-wiring.html')} title="UI pod wiring diagram" loading="lazy" style="width:100%;height:560px;border:1px solid var(--line);border-radius:12px;background:#fff"></iframe>
        <p class="small muted"><a href={href('/embeds/ui-pod-wiring.html')} target="_blank" rel="noopener">Open full page ↗</a></p>
      </div>
    </div>
  </Section>
</Base>
<style>
  .leds { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .led { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: .5rem; vertical-align: middle; box-shadow: 0 0 0 3px rgba(0,0,0,.06); }
</style>
