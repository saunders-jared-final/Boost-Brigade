---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Figure from '../components/Figure.astro';
import Callout from '../components/Callout.astro';
import Carousel from '../components/Carousel.astro';
import Claim from '../components/Claim.astro';
import { CASES } from '../data/testcases';
import { fig, figsIn } from '../lib/assets';
import { href, repoUrl, repoDir, reportUrl } from '../lib/site';
import { readRepo, markdownSection } from '../lib/repo';

const report = readRepo('8_Results/analysis/REPORT.md');
const findings = markdownSection(report, /^## 7/).split('\n').filter((l) => /^\d+\./.test(l)).map((l) => l.replace(/^\d+\.\s*/, ''));
const caveats = markdownSection(report, /^## 9/).split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2));
const overviews = figsIn('analysis').filter((f) => f.key.includes('_overview'));
const events = figsIn('analysis').filter((f) => /_e\d_/.test(f.key));
const compare = figsIn('analysis').filter((f) => f.key.includes('/step_'));
const hw = (id: string) => overviews.find((f) => f.key.includes(`/${id}_`));
const pretty = (k: string) => k.split('/').pop()!.replace(/_/g, ' ');
---
<Base title="Results" description="Bench and carpark results of the power shuffler string: 21 hardware windows, energy returned, step responses and the cross-phase comparison with its caveats.">
  <Section eyebrow="Results" title="What the hardware measured" lede="Two days, 21 windows, one pipeline. Everything below is regenerated by make all in 8_Results/analysis; the figure names carry the run id, the switching frequency and the gain scale. Click any plot to see it full size." narrow />

  <Section tight>
    <div class="grid grid-3">
      <Claim big="Within 10 mV" what="Module-voltage difference held by the closed loop across 22 settled segments, 200–400 kHz, bench and sun." colour="blue" />
      <Claim big="99 W · 10.6 Wh" what="Peak power and energy returned to a 61 V load over 36 minutes with the top panel shaded to about zero current." colour="accent" />
      <Claim big="1.2 % and 3 %" what="Agreement of the averaged model's DC gain with open-loop duty steps on hardware, and of the switching ripple with the closed-form law." colour="green" />
    </div>
  </Section>

  <Section alt eyebrow="20 Oct 2026 · carpark" title="Energy returned with a dead top panel">
    <div class="wrap-narrow" style="width:100%">
      {fig('analysis/S02_shade_power') && <Figure src={fig('analysis/S02_shade_power')!} alt="Run S02 string power through the shade event" caption="Run S02 at peak sun: the shade event (a shirt over a third of the top panel) and the shufflers keeping the other two modules delivering. Peak 99 W." evidence={{ label: 'TestCases S02', href: repoDir('8_Results/TestCases') }} />}
      {fig('analysis/solar_energy') && <Figure src={fig('analysis/solar_energy')!} alt="Energy returned over the carpark afternoon" caption="Cumulative energy to the 61 V load over 36 minutes of RUN time: 10.62 Wh." evidence={{ label: 'Delivery report §4.6', href: reportUrl('control', 27) }} />}
    </div>
    <Callout kind="warn" title="How to read the headline">Module 1 carried about 0 A all afternoon, so a plain series string at this load would have been starved. The hardware stream's own open-loop measurements with the shufflers off at the same load read 40 / 9 / 5 W in three runs, so "nothing" is an overstatement: the honest claim is that nearly all of the 10.6 Wh is energy that would otherwise have been lost. Irradiance was not logged.</Callout>
    <h3>Events in run S02</h3>
    <Carousel>{events.filter((f) => f.key.includes('S02')).map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
  </Section>

  <Section eyebrow="16 Oct 2026 · bench" title="Closed loop at 200, 300 and 400 kHz">
    <div class="wrap-narrow" style="width:100%">
      {fig('results/bench_B06') && <Figure src={fig('results/bench_B06')!} alt="Run B06 overview, 300 kHz closed loop at 30 % gain" caption="Run B06: 300 kHz, gain scale 0.3, supply and load set-point steps while closed. The loop holds the voltage difference within ±10 mV." evidence={{ label: 'Delivery report §4.5', href: reportUrl('control', 26) }} />}
    </div>
    <h3>Events in runs B06 and B01s</h3>
    <Carousel>{events.filter((f) => f.key.includes('B06') || f.key.includes('B01s')).map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    <p class="small muted">The operator's log of the day, including the three trips that all followed a live gain change, is in <a class="ext" href={repoUrl('0_Documentation/Bench Test Day.txt')} target="_blank" rel="noopener">Bench Test Day.txt</a>. The hardware stream's open-loop bench results (power with and without the shufflers, ripple against the model) are on the <a href={href('/hardware/pcb/')}>PCB page</a>.</p>
  </Section>

  <Section alt eyebrow="All 21 windows" title="Test-case inventory">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Run</th><th>Day</th><th>f_sw</th><th>Loop</th><th>Gain</th><th>Window (AEST)</th><th>Note</th><th>Figure</th></tr></thead>
        <tbody>
          {CASES.map((c) => (
            <tr>
              <td class="mono"><strong>{c.id}</strong></td><td>{c.day}</td><td class="mono small">{c.fsw}</td><td><span class:list={['chip', c.loop === 'CL' ? 'chip-green' : 'chip']}>{c.loop}</span></td><td class="mono small">{c.k ?? '–'}</td><td class="mono small">{c.window}</td><td class="small muted">{c.note}</td>
              <td>{hw(c.id) && <a class="mono small ext" href={hw(c.id)!.img.src} target="_blank" rel="noopener">overview</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Raw CSVs (telemetry at about 45 Hz, e-load at 5 Hz, command log) in <a class="ext" href={repoDir('8_Results/TestCases')} target="_blank" rel="noopener">8_Results/TestCases</a>.</p>
    <details class="fold"><summary>All hardware overview figures ({overviews.length})</summary>
      <Carousel>{overviews.map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    </details>
  </Section>

  <Section eyebrow="Four phases, one scenario" title="Analytical, QSPICE, Simulink and hardware, compared">
    <p class="muted" style="max-width:72ch">The same reference-step and loop-closure scenarios were run on the analytical N = 3 model, in QSPICE with the firmware DLL, on the Simulink carpark twin, and on the bench. Time constants relative to the first-order design: analytical 0.86–1.22×, QSPICE 0.52–1.17×, Simulink 0.38–1.10×. Hardware times are bounds below one telemetry frame.</p>
    <div class="wrap-narrow" style="width:100%">
      {fig('results/twin_sim') && <Figure src={fig('results/twin_sim')!} alt="Simulation twin comparison" caption="Scenario comparison across the simulation phases." />}
      {fig('results/metrics_k') && <Figure src={fig('results/metrics_k')!} alt="Closed-loop metrics against gain scale across phases" caption="Settling metrics against gain scale, all phases: the hardware times are bounds set by the 44 Hz telemetry." evidence={{ label: 'Delivery report §4.7', href: reportUrl('control', 28) }} />}
      {fig('analysis/S5_duty_steps_hw_vs_analytical') && <Figure src={fig('analysis/S5_duty_steps_hw_vs_analytical')!} alt="Hardware duty steps against the analytical model" caption="Scenario duty-steps: hardware (B01s) against the analytical model." />}
      {fig('results/thermal') && <Figure src={fig('results/thermal')!} alt="Thermal results" caption="Hottest INA239 die temperature in every test window, bench and carpark." />}
    </div>
    <details class="fold"><summary>Step-response figures by gain scale ({compare.length})</summary>
      <Carousel>{compare.map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    </details>
  </Section>

  <Section alt eyebrow="Computed findings" title="What the pipeline concluded" narrow>
    <ol class="prose">
      {findings.map((f) => <li>{f}</li>)}
    </ol>
    <p class="small muted">Verbatim from <a class="ext" href={repoUrl('8_Results/analysis/REPORT.md')} target="_blank" rel="noopener">REPORT.md §7</a>, read at build time.</p>
  </Section>

  <Section id="caveats" eyebrow="Caveats" title="Where the numbers stop being measurements" narrow>
    <ul class="prose">
      {caveats.map((c) => <li>{c}</li>)}
    </ul>
    <p class="small muted">From REPORT.md §9.</p>
  </Section>
</Base>
