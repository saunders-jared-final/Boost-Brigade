---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Figure from '../components/Figure.astro';
import Callout from '../components/Callout.astro';
import Carousel from '../components/Carousel.astro';
import { CASES } from '../data/testcases';
import { fig, figsIn } from '../lib/assets';
import { href, repoUrl, repoDir, reportUrl } from '../lib/site';
import { readRepo, markdownSection } from '../lib/repo';

const report = readRepo('8_Results/analysis/REPORT.md');
const findings = markdownSection(report, /^## 7/).split('\n').filter((l) => /^\d+\./.test(l)).map((l) => l.replace(/^\d+\.\s*/, ''));
const caveats = markdownSection(report, /^## 9/).split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2));
const overviews = figsIn('analysis').filter((f) => f.key.includes('_overview'));
const events = figsIn('analysis').filter((f) => /_e\d_/.test(f.key));
const compare = figsIn('analysis').filter((f) => f.key.includes('/step_'));
const hw = (id: string) => overviews.find((f) => f.key.includes(`/${id}_`));
/** Figure keys carry the run id, frequency, loop and gain; turn them into readable captions. */
const EVENT: Record<string, string> = { close: 'the loop closes', load_step: 'load step', duty_step: 'duty step', mismatch_on: 'mismatch switched on', irradiance_up: 'irradiance rises', irradiance_down: 'irradiance falls' };
const pretty = (key: string) => {
  const k = key.split('/').pop()!;
  let m = k.match(/^([BS]\d+s?)_e(\d+)_(.+)$/);
  if (m) return `Run ${m[1]}, event ${m[2]}: ${EVENT[m[3]] ?? m[3].replace(/_/g, ' ')}`;
  m = k.match(/^([BS]\d+s?)_(bench|solar)_(\d+)k_(OL|CL)(?:_k([\d.]+)b?)?(?:_(\w+?))?_overview$/);
  if (m) return `Run ${m[1]}: ${m[2] === 'bench' ? 'bench' : 'sun'}, ${m[3]} kHz, ${m[4] === 'CL' ? `closed loop, k = ${m[5]}` : 'open loop'}${m[6] && m[6] !== 'dutysteps' ? `, ${m[6]} irradiance` : m[6] === 'dutysteps' ? ', duty steps' : ''}`;
  m = k.match(/^step_(S\d+)_(\w+?)_k([\d.]+)_(\w+)$/);
  if (m) return `Scenario ${m[1]} (${m[2].toLowerCase()}), k = ${m[3]}: ${m[4].replace(/(\D+)(\d)/, '$1 $2')}`;
  return k.replace(/_/g, ' ');
};
/** REPORT.md lines are markdown: render `code` and **bold**, escape the rest. */
const md = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
const ANSWERS = [
  { q: 'Does it work?', a: 'Yes, on hardware and in the sun.', body: 'The loop closed at 200, 300 and 400 kHz on the bench, and at every gain scale from 0.1 to 0.8 in the carpark without a fault. The three bench trips all followed a gain change made while the loop was running.', link: '#bench', more: 'The bench day', colour: 'blue' },
  { q: 'How well?', a: 'Within 10 mV, and 99 W back.', body: 'The closed loop held the module-voltage difference within 10 mV across 22 settled segments. In the carpark, with the top panel shaded to about zero current, it returned up to 99 W and 10.6 Wh over 36 minutes.', link: '#carpark', more: 'The carpark run', colour: 'accent' },
  { q: 'How sure are we?', a: 'The models agree to a few per cent.', body: 'The averaged model’s DC gain matched open-loop duty steps on hardware to 1.2\u00a0%, and the switching ripple matched the closed-form law to 3\u00a0%. Hardware settling times are bounds set by the 44 Hz telemetry, and irradiance was not logged.', link: '#caveats', more: 'The limits', colour: 'green' },
];
---
<Base title="Results" description="Bench and carpark results of the power shuffler string: 21 hardware windows, energy returned, step responses and the cross-phase comparison with its caveats.">
  <Section title="What the hardware measured" lede="Two test days, 21 recorded windows, one analysis pipeline. Three questions first; the evidence for each follows." narrow />

  <Section tight>
    <div class="answers">
      {ANSWERS.map((x) => (
        <article class:list={['answer', x.colour]}>
          <h2 class="answer-q">{x.q}</h2>
          <p class="answer-a">{x.a}</p>
          <p class="answer-body">{x.body}</p>
          <a class="small" href={x.link}>{x.more}</a>
        </article>
      ))}
    </div>
  </Section>

  <Section alt id="carpark" eyebrow="20 Oct 2026 · carpark" title="Energy returned with a dead top panel">
    <div class="wrap-narrow" style="width:100%">
      {fig('analysis/S02_shade_power') && <Figure src={fig('analysis/S02_shade_power')!} alt="Run S02 string power through the shade event" caption="Run S02 at peak sun: the shade event (a shirt over a third of the top panel) and the shufflers keeping the other two modules delivering. Peak 99 W." evidence={{ label: 'TestCases S02', href: repoDir('8_Results/TestCases') }} />}
      {fig('analysis/solar_energy') && <Figure src={fig('analysis/solar_energy')!} alt="Energy returned over the carpark afternoon" caption="Cumulative energy to the 61 V load over 36 minutes of RUN time: 10.62 Wh." evidence={{ label: 'Delivery report, fig. 16', href: reportUrl('control', 27) }} />}
    </div>
    <Callout kind="warn" title="How to read the headline">Module 1 carried about 0 A all afternoon, so a plain series string at this load would have been starved. The hardware stream's own open-loop measurements with the shufflers off at the same load read 40 / 9 / 5 W in three runs, so "nothing" is an overstatement: the honest claim is that nearly all of the 10.6 Wh is energy that would otherwise have been lost. Irradiance was not logged.</Callout>
    <h3>Events in run S02</h3>
    <Carousel>{events.filter((f) => f.key.includes('S02')).map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
  </Section>

  <Section id="bench" eyebrow="16 Oct 2026 · bench" title="Closed loop at 200, 300 and 400 kHz">
    <div class="wrap-narrow" style="width:100%">
      {fig('results/bench_B06') && <Figure src={fig('results/bench_B06')!} alt="Run B06 overview, 300 kHz closed loop at 30 % gain" caption="Run B06: 300 kHz, gain scale 0.3, supply and load set-point steps while closed. The loop holds the voltage difference within ±10 mV." evidence={{ label: 'Delivery report, fig. 15', href: reportUrl('control', 26) }} />}
    </div>
    <h3>Events in runs B06 and B01s</h3>
    <Carousel>{events.filter((f) => f.key.includes('B06') || f.key.includes('B01s')).map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    <p class="small muted">The operator's log of the day, including the three trips that all followed a live gain change, is in <a class="ext" href={repoUrl('0_Documentation/Bench Test Day.txt')} target="_blank" rel="noopener">Bench Test Day.txt</a>. The hardware stream's open-loop bench results (power with and without the shufflers, ripple against the model) are on the <a href={href('/hardware/pcb/')}>PCB page</a>.</p>
  </Section>

  <Section alt title="All 21 test windows" lede="Every recorded window, with its switching frequency, loop state and gain scale. Raw CSVs are in the repository.">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Run</th><th>Day</th><th>f_sw</th><th>Loop</th><th>Gain</th><th>Window (AEST)</th><th>Note</th><th>Figure</th></tr></thead>
        <tbody>
          {CASES.map((c) => (
            <tr>
              <td class="mono"><strong>{c.id}</strong></td><td>{c.day}</td><td class="mono small">{c.fsw}</td><td><span class:list={['chip', c.loop === 'CL' ? 'chip-green' : 'chip']}>{c.loop}</span></td><td class="mono small">{c.k ?? '–'}</td><td class="mono small">{c.window}</td><td class="small muted">{c.note}</td>
              <td>{hw(c.id) && <a class="mono small ext" href={hw(c.id)!.img.src} target="_blank" rel="noopener">overview</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Raw CSVs (telemetry at about 45 Hz, e-load at 5 Hz, command log) in <a class="ext" href={repoDir('8_Results/TestCases')} target="_blank" rel="noopener">8_Results/TestCases</a>.</p>
    <details class="fold"><summary>All hardware overview figures ({overviews.length})</summary>
      <Carousel>{overviews.map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    </details>
  </Section>

  <Section title="One scenario, four phases" lede="The same reference-step and loop-closure scenarios ran on the analytical model, in QSPICE with the firmware DLL, on the Simulink carpark twin and on the bench.">
    <div class="table-wrap phases">
      <table>
        <thead><tr><th>Phase</th><th>Settling time against the first-order design</th></tr></thead>
        <tbody>
          <tr><td>Analytical N = 3 model</td><td class="mono">0.86–1.22×</td></tr>
          <tr><td>QSPICE with the firmware DLL</td><td class="mono">0.52–1.17×</td></tr>
          <tr><td>Simulink carpark twin</td><td class="mono">0.38–1.10×</td></tr>
          <tr><td>Hardware</td><td>a bound: faster than one telemetry frame</td></tr>
        </tbody>
      </table>
    </div>
    <div class="wrap-narrow" style="width:100%">
      {fig('results/twin_sim') && <Figure src={fig('results/twin_sim')!} alt="Simulation twin comparison" caption="Scenario comparison across the simulation phases." />}
      {fig('results/metrics_k') && <Figure src={fig('results/metrics_k')!} alt="Closed-loop metrics against gain scale across phases" caption="Settling metrics against gain scale, all phases: the hardware times are bounds set by the 44 Hz telemetry." evidence={{ label: 'Delivery report, fig. 17', href: reportUrl('control', 28) }} />}
      {fig('analysis/S5_duty_steps_hw_vs_analytical') && <Figure src={fig('analysis/S5_duty_steps_hw_vs_analytical')!} alt="Hardware duty steps against the analytical model" caption="Scenario duty-steps: hardware (B01s) against the analytical model." />}
      {fig('results/thermal') && <Figure src={fig('results/thermal')!} alt="Thermal results" caption="Hottest INA239 die temperature in every test window, bench and carpark." />}
    </div>
    <details class="fold"><summary>Step-response figures by gain scale ({compare.length})</summary>
      <Carousel>{compare.map((f) => <Figure src={f.img} alt={pretty(f.key)} caption={pretty(f.key)} />)}</Carousel>
    </details>
  </Section>

  <Section alt id="caveats" title="The limits of these numbers" lede="What the measurements can and cannot support, from the analysis report." narrow>
    <ul class="limits">
      {caveats.map((c) => <li set:html={md(c)} />)}
    </ul>
    <details class="fold"><summary>The pipeline's nine computed findings, in full</summary>
      <ol class="findings">
        {findings.map((f) => <li set:html={md(f)} />)}
      </ol>
      <p class="small muted">Read at build time from <a class="ext" href={repoUrl('8_Results/analysis/REPORT.md')} target="_blank" rel="noopener">REPORT.md</a> §7 (findings) and §9 (limits).</p>
    </details>
  </Section>
</Base>
<style>
  .answers { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .answer { --c: var(--accent); border: 1px solid color-mix(in srgb, var(--c) 40%, var(--line)); background: color-mix(in srgb, var(--c) 6%, var(--surface)); border-radius: var(--radius); padding: 1.3rem 1.4rem; display: grid; gap: .5rem; align-content: start; }
  .answer.blue { --c: var(--blue); }
  .answer.green { --c: var(--green); }
  .answer-q { font-size: .95rem; font-family: var(--font-body); font-weight: 600; color: var(--muted); margin: 0; }
  .answer-a { font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.7rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  .answer-body { color: var(--muted); margin: 0; }
  .phases { max-width: 640px; margin-bottom: 1.5rem; }
  .limits { display: grid; gap: .7rem; padding-left: 1.2rem; }
  .limits li::marker { color: var(--red); }
  .findings { display: grid; gap: .6rem; padding-left: 1.4rem; font-size: .95rem; }
</style>
