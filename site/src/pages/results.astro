---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Figure from '../components/Figure.astro';
import Callout from '../components/Callout.astro';
import Snippet from '../components/Snippet.astro';
import StatTile from '../components/StatTile.astro';
import { STATS } from '../data/stats';
import { CASES } from '../data/testcases';
import { fig, figsIn } from '../lib/assets';
import { repoUrl, repoDir } from '../lib/site';
import { readRepo, markdownSection } from '../lib/repo';

const report = readRepo('8_Results/analysis/REPORT.md');
const findings = markdownSection(report, /^## 7/).split('\n').filter((l) => /^\d+\./.test(l)).map((l) => l.replace(/^\d+\.\s*/, ''));
const caveats = markdownSection(report, /^## 9/).split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2));
const overviews = figsIn('analysis').filter((f) => f.key.includes('_overview'));
const events = figsIn('analysis').filter((f) => /_e\d_/.test(f.key));
const compare = figsIn('analysis').filter((f) => f.key.includes('/step_'));
const hw = (id: string) => overviews.find((f) => f.key.includes(`/${id}_`));
---
<Base title="Results" description="Bench and carpark results of the power shuffler string: 21 hardware windows, energy returned, step responses and cross-phase comparison with caveats.">
  <Section eyebrow="Results" title="What the hardware measured" lede="Two days, 21 windows, one pipeline. Everything below is regenerated by make all in 8_Results/analysis; the figure names carry the run id, switching frequency and gain scale." />

  <Section tight>
    <div class="grid grid-4">
      {STATS.map((s) => <StatTile value={s.value} label={s.label} evidence={s.evidence} href={s.href} />)}
    </div>
  </Section>

  <Section alt eyebrow="20 Oct 2026 · carpark" title="Energy returned with a dead top panel">
    <div class="grid grid-2" style="align-items:start">
      {fig('analysis/solar_energy') && <Figure src={fig('analysis/solar_energy')!} alt="Energy returned over the carpark afternoon" caption="Cumulative energy to the 61 V load over 36 minutes of RUN time: 10.62 Wh." evidence={{ label: 'REPORT §4', href: repoUrl('8_Results/analysis/REPORT.md') }} />}
      {fig('analysis/S02_shade_power') && <Figure src={fig('analysis/S02_shade_power')!} alt="Run S02 string power through the shade event" caption="Run S02 at peak sun: the shade event (a shirt over a third of the top panel) and the shufflers keeping the other two modules delivering. Peak 99 W." evidence={{ label: 'TestCases S02', href: repoDir('8_Results/TestCases') }} />}
    </div>
    <Callout kind="warn" title="How to read the headline">Module 1 carried about 0 A all afternoon, so a plain series string at this load would have been starved. The hardware stream’s own measurement with the shufflers off at the same load read 40 / 9 / 5 W in three checks, so “nothing” is an overstatement: the honest claim is that nearly all of the 10.6 Wh is energy that would otherwise have been lost. Irradiance was not logged.</Callout>
    <div class="fig-grid">
      {events.filter((f) => f.key.includes('S02')).map((f) => <Figure src={f.img} alt={f.key} caption={f.key.split('/').pop()!.replace(/_/g, ' ')} />)}
    </div>
  </Section>

  <Section eyebrow="16 Oct 2026 · bench" title="Closed loop at 200, 300 and 400 kHz">
    <div class="grid grid-2" style="align-items:start">
      {fig('results/bench_B06') && <Figure src={fig('results/bench_B06')!} alt="Run B06 overview, 300 kHz closed loop at kscale 0.3" caption="Run B06: 300 kHz, kscale 0.3, PSU and e-load set-point steps while closed. The loop holds v_d2 within ±10 mV." />}
      <div>
        <div class="fig-grid">
          {events.filter((f) => f.key.includes('B06') || f.key.includes('B01s')).map((f) => <Figure src={f.img} alt={f.key} caption={f.key.split('/').pop()!.replace(/_/g, ' ')} />)}
        </div>
      </div>
    </div>
    <h3 style="margin-top:1.5rem">The bench day as it happened</h3>
    <Snippet file="0_Documentation/Bench Test Day.txt" from={1} to={60} lang="text" title="Bench Test Day.txt — operator log (excerpt)" note="“Gain 10% lasted the longest. Eventually psu freaks out.” The three trips of the day all followed a live gain change." />
  </Section>

  <Section alt eyebrow="All 21 windows" title="Test-case inventory">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Run</th><th>Day</th><th>f_sw</th><th>Loop</th><th>kscale</th><th>Window (AEST)</th><th>Note</th><th>Figure</th></tr></thead>
        <tbody>
          {CASES.map((c) => (
            <tr>
              <td class="mono"><strong>{c.id}</strong></td><td>{c.day}</td><td class="mono small">{c.fsw}</td><td><span class:list={['chip', c.loop === 'CL' ? 'chip-green' : 'chip']}>{c.loop}</span></td><td class="mono small">{c.k ?? '–'}</td><td class="mono small">{c.window}</td><td class="small muted">{c.note}</td>
              <td>{hw(c.id) && <a class="mono small" href={hw(c.id)!.img.src} target="_blank" rel="noopener">overview ↗</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Raw CSVs (telemetry at ~45 Hz, e-load at 5 Hz, command log) in <a href={repoDir('8_Results/TestCases')} target="_blank" rel="noopener">8_Results/TestCases</a>. A browser replay of these windows is on the roadmap for this site.</p>
    <details>
      <summary class="mono small" style="cursor:pointer">All hardware overview figures ({overviews.length})</summary>
      <div class="fig-grid" style="margin-top:1rem">
        {overviews.map((f) => <Figure src={f.img} alt={f.key} caption={f.key.split('/').pop()!.replace(/_/g, ' ')} />)}
      </div>
    </details>
  </Section>

  <Section eyebrow="Four phases, one scenario" title="Analytical vs QSPICE vs Simulink vs hardware">
    <p class="muted" style="max-width:70ch">The same reference step and loop-closure scenarios were run on the analytical N = 3 model, in QSPICE with the firmware DLL, on the Simulink carpark twin, and on the bench. Time constants relative to the first-order design 1/(k·2π·150 Hz): analytical 0.86–1.22×, QSPICE 0.52–1.17×, Simulink 0.38–1.10×. Hardware times are bounds below one telemetry frame.</p>
    <div class="grid grid-2">
      {fig('results/twin_sim') && <Figure src={fig('results/twin_sim')!} alt="Simulation twin comparison" caption="Scenario comparison across the simulation phases." />}
      {fig('analysis/S5_duty_steps_hw_vs_analytical') && <Figure src={fig('analysis/S5_duty_steps_hw_vs_analytical')!} alt="Hardware duty steps vs analytical" caption="Scenario duty-steps: hardware (B01s) against the analytical model." />}
    </div>
    <details>
      <summary class="mono small" style="cursor:pointer">Step-response figures by kscale ({compare.length})</summary>
      <div class="fig-grid" style="margin-top:1rem">
        {compare.map((f) => <Figure src={f.img} alt={f.key} caption={f.key.split('/').pop()!.replace(/_/g, ' ')} />)}
      </div>
    </details>
    {fig('results/thermal') && <Figure src={fig('results/thermal')!} alt="Thermal results" caption="Heatsink and INA die temperatures on the bench and in the carpark." />}
  </Section>

  <Section alt eyebrow="Computed findings" title="What the pipeline concluded" narrow>
    <ol class="prose">
      {findings.map((f) => <li>{f}</li>)}
    </ol>
    <p class="small muted">Verbatim from <a href={repoUrl('8_Results/analysis/REPORT.md')} target="_blank" rel="noopener">REPORT.md §7</a>, read at build time.</p>
  </Section>

  <Section id="caveats" eyebrow="Caveats" title="Where the numbers stop being measurements" narrow>
    <ul class="prose">
      {caveats.map((c) => <li>{c}</li>)}
    </ul>
    <p class="small muted">From REPORT.md §9.</p>
  </Section>
</Base>
<style>
  .fig-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 1rem; }
  .fig-grid :global(.figure) { margin: 0; }
</style>
