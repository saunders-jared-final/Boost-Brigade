---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Gallery from '../components/Gallery.astro';
import YouTube from '../components/YouTube.astro';
import { PHOTOS, THUMBS, figsIn } from '../lib/assets';
import { Image } from 'astro:assets';
import photos from '../data/photos.json';
import { repoUrl, rawUrl } from '../lib/site';

const items = photos.filter((p: any) => PHOTOS[p.file.replace(/\.webp$/, '')] && !p.file.startsWith('Messenger_creation')).map((p: any) => {
  const s = p.file.replace(/\.webp$/, '');
  return { full: PHOTOS[s], thumb: THUMBS[s], caption: p.caption, date: p.date, tags: p.tags };
});
const tags = Array.from(new Set(items.flatMap((i) => i.tags ?? []))) as string[];
const slides = figsIn('slides').filter((f) => f.key.includes('img-'));
const videos = [
  { file: '20261016_153339.mp4', title: 'Bench run 1 (16 Oct, 28 MB)', note: 'Open-loop warm-up at 200 kHz with the scope on the switch node.' },
  { file: '20261016_155135.mp4', title: 'Bench run 2 (16 Oct, 90 MB)', note: 'Closed loop at 300 kHz, gain scale 0.3; Grafana live.' },
  { file: '20261016_160400.mp4', title: 'Bench run 3 (16 Oct, 42 MB)', note: 'Pod LCD, IR remote presets, LED states.' },
  { file: '20261016_173330.mp4', title: 'Bench run 4 (16 Oct, 147 MB)', note: 'Gain step and supply set-point steps while closed.' },
];
const tours = [
  { title: 'QSPICE model tour', note: 'The hierarchical Power_Shuffler_Integrated sheet, the control DLL and the stage ladder.' },
  { title: 'KiCad board tour', note: 'Schematic sheets, the six-layer stack and the sensing chain.' },
  { title: 'Flash and run the pod', note: 'From a fresh Pi to telemetry in Grafana, then open- and closed-loop presets.' },
  { title: 'Reading the dashboard', note: 'What each of the 16 Grafana panels means and what a healthy run looks like.' },
];
---
<Base title="Media" description="Photos, videos and slides from the Boost Brigade power shuffler project.">
  <Section eyebrow="Media" title="Photos, videos and slides" lede="The build from the first strip-board in August to the carpark in October. Click any photo for full size." narrow>
    <div class="row" id="tag-filter" role="group" aria-label="Filter photos">
      <button class="chip chip-accent" data-tag="" type="button" aria-pressed="true">all</button>
      {tags.map((t) => <button class="chip" data-tag={t} type="button" aria-pressed="false">{t}</button>)}
    </div>
  </Section>
  <Section tight>
    <Gallery items={items} id="photos" />
  </Section>

  <Section alt eyebrow="Video" title="Bench clips and walkthroughs" lede="The bench clips stream straight from the repository (1080p, large files). Walkthroughs will be hosted on YouTube and embedded here once recorded.">
    <h3>16 Oct bench day</h3>
    <div class="grid grid-2">
      {videos.map((v) => <YouTube title={v.title} note={v.note} mp4={rawUrl(`0_Documentation/Photos/${v.file}`)} />)}
    </div>
    <h3 style="margin-top:2rem">Tool walkthroughs</h3>
    <div class="grid grid-2">
      {tours.map((v) => <YouTube title={v.title} note={v.note} />)}
    </div>
    <p class="small muted">Source clips: <a class="ext" href={repoUrl('0_Documentation/Photos')} target="_blank" rel="noopener">0_Documentation/Photos</a>.</p>
  </Section>

  <Section eyebrow="Slides" title="From the final presentation" lede="Crops from the delivery deck (23 Oct 2026).">
    <div class="slides">
      {slides.map((s) => <Image src={s.img} alt={`Slide crop ${s.key.split('/').pop()}`} width={640} loading="lazy" />)}
    </div>
  </Section>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#tag-filter button');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => { x.setAttribute('aria-pressed', 'false'); x.classList.remove('chip-accent'); });
    b.setAttribute('aria-pressed', 'true'); b.classList.add('chip-accent');
    const tag = b.dataset.tag || '';
    document.querySelectorAll<HTMLElement>('#photos .g-item').forEach((it) => { it.hidden = !!tag && !(it.dataset.tags || '').split(' ').includes(tag); });
  }));
</script>
<style>
  .slides { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: .8rem; }
  .slides :global(img) { border-radius: 10px; border: 1px solid var(--line); background: #fff; }
</style>
