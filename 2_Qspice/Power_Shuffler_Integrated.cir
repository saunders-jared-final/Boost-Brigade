.subckt Controller PV1P PV2P PV3P HS_A1 HS_B1 HS_A2 HS_B2 PWM_AH1 PWM_AL1 PWM_BH1 PWM_BL1 PWM_AH2 PWM_AL2 PWM_BH2 PWM_BL2
Ven CTRL_EN 0 PWL(0 0 {TEN} 0 {TEN+1u} 1)
Vref1 VREF1 0 PWL(0 0 {TSTEP} 0 {TSTEP+1u} {VSTEP1})
Vref2 VREF2 0 PWL(0 0 {TSTEP} 0 {TSTEP+1u} {VSTEP2})
Vrampa RAMPA 0 PULSE(0 1 0 {Tsw-2n} 1n 1n {Tsw})
Vrampb RAMPB 0 PULSE(0 1 {Tsw/2} {Tsw-2n} 1n 1n {Tsw})
BtKSCALE KSCALE 0 V=KSCALE
BtMSEL MSEL 0 V=MSEL
BtFILT FILT 0 V=FILT
BtFC FC 0 V=FC
BtNOISE NOISE 0 V=NOISE
BtSAMP SAMP 0 V=SAMP
BtKBERR KBERR 0 V=KBERR
BtFSWP FSWP 0 V=1/Tsw
BtVM1SRC VM1SRC 0 V=VM1SRC
BtVSTRP VSTRP 0 V=VSTRP
Ø´Xc «PV1P´d PV2P´d PV3P´d HS_A1´d HS_B1´d HS_A2´d HS_B2´d CTRL_EN´d VREF1´d VREF2´d KSCALE´d MSEL´d FILT´d FC´d NOISE´d SAMP´d KBERR´d FSWP´d VM1SRC´d VSTRP´d» «DA1´d DB1´d DA2´d DB2´d RV1´d RV2´d BETA´d STRESS´d IM1R´d IM2R´d» «0»  shuffler_ctrl_dll2 Rout=1 Cout=1p
BdDA1 DA1C 0 V=duty(V(CTRL_EN),V(DA1),D0A1)
BdDB1 DB1C 0 V=duty(V(CTRL_EN),V(DB1),D0B1)
BdDA2 DA2C 0 V=duty(V(CTRL_EN),V(DA2),D0A2)
BdDB2 DB2C 0 V=duty(V(CTRL_EN),V(DB2),D0B2)
XP1 RAMPA RAMPB DA1C DB1C PWM_AH1 PWM_AL1 PWM_BH1 PWM_BL1 PWM_Modulator
XP2 RAMPA RAMPB DA2C DB2C PWM_AH2 PWM_AL2 PWM_BH2 PWM_BL2 PWM_Modulator
 .subckt PWM_Modulator RAMPA RAMPB DA DB PWM_AH PWM_AL PWM_BH PWM_BL
 BpTA PWM_AH 0 V=pwm_top(V(RAMPA),V(DA))
 BpBA PWM_AL 0 V=pwm_bot(V(RAMPA),V(DA))
 BpTB PWM_BH 0 V=pwm_top(V(RAMPB),V(DB))
 BpBB PWM_BL 0 V=pwm_bot(V(RAMPB),V(DB))
 .ends PWM_Modulator
.ends Controller


