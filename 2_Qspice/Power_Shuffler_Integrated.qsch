  «text (-12000,9600) 2 7 1 0x1000000 -1 -1 "ï»¿POWER SHUFFLER - the hand-drawn v3 string and converters with the firmware control stack, as hierarchical sheets"»
  «text (-12000,9200) 1 7 1 0x1000000 -1 -1 "ï»¿Blocks: XS1 / XS2 = Shuffler_1.qsch / Shuffler_2.qsch (the drawn converters with their hall sensors), XC = Controller.qsch (the DLL, its sources,"»
  «text (-12000,9000) 1 7 1 0x1000000 -1 -1 "ï»¿and two PWM_Modulator.qsch comparator sheets). Right-click a block and open its schematic to look inside; every sheet carries its own notes."»
  «text (-12000,8800) 1 7 1 0x1000000 -1 -1 "ï»¿Files that must sit next to this sheet: the four sub-sheets, HalfBridge_Driver.qsch, shuffler_ctrl_dll2.dll, ctrl_M2.txt (MSEL = 2); MyLibrary.lib via the library path."»
  «text (-12000,8600) 1 7 1 0x1000000 -1 -1 "ï»¿Nodes: Out = PV1+ at the load, PV2P / PV3P = the INA239 string nodes, T1 / B1 and T2 / M2 / B2 = the converter rails behind the cable and copper inductors L23-L28."»
  «text (-12000,8400) 1 7 1 0x1000000 -1 -1 "ï»¿Inside a block, name a current or node with QSPICE's bullet: I(V4â€¢XS1), V(DA1â€¢XC). The PARAMETERS column is the one place to edit."»
  «text (-12000,8200) 1 7 1 0x1000000 -1 -1 "ï»¿Generated by Claude's outputs/build_power_shuffler_integrated.py from Buck Boost Full Bridge - v3.qsch (which it never writes); hand edits and the generator do not mix."»
  «text (-12000,7100) 1.2 7 1 0x1000000 -1 -1 "ï»¿SHADE RAMPS V1 / V2 (Vtest, Vtest2: irradiance of module 2 in both strings), Vref and Vcc as drawn"»
  «text (-11200,3950) 1.2 7 1 0x1000000 -1 -1 "ï»¿REFERENCE STRING - the same modules and load, never gets a converter (comparison only)"»
  «text (-5600,4900) 1.2 7 1 0x1000000 -1 -1 "ï»¿PV STRING - X1-X3 Aiko modules, L1-L6 lead inductors, D4-D6 bypass diodes, L23-L28 cable / copper to the converters"»
  «text (-2500,6700) 1.2 7 1 0x1000000 -1 -1 "ï»¿LOAD I1 on Out (13 A ramp, VSAT 137.4 V)"»
  «text (3300,4100) 1.2 7 1 0x1000000 -1 -1 "ï»¿SHUFFLER 1 - converter 1 on PV1+ / PV2+ / PV3+ (Shuffler_1.qsch)"»
  «text (3300,-1900) 1.2 7 1 0x1000000 -1 -1 "ï»¿SHUFFLER 2 - converter 2 on PV2+ / PV3+ / GND (Shuffler_2.qsch)"»
  «text (9000,1100) 1.2 7 1 0x1000000 -1 -1 "ï»¿CONTROLLER - firmware control stack, DLL + PWM modulators (Controller.qsch)"»
  «text (-12000,-7750) 1.4 7 1 0x1000000 -1 -1 "ï»¿PARAMETERS - edit values here (units: m = milli, u = micro, n = nano, p = pico)"»
  «text (-12000,-8000) 1 7 1 0x1000000 -1 -1 "ï»¿* PWM"»
  «text (-12000,-8150) 1 7 0 0x1000000 -1 -1 "ï»¿.param Tsw=5u"»
  «text (-8000,-8150) 1 7 1 0x1000000 -1 -1 "ï»¿PWM period: 5 u = 200 kHz (FSWP for the DLL follows 1/Tsw)"»
  «text (-12000,-8300) 1 7 0 0x1000000 -1 -1 "ï»¿.param Tdead=200n"»
  «text (-8000,-8300) 1 7 1 0x1000000 -1 -1 "ï»¿dead time cut from both edges of every FET pulse"»
  «text (-12000,-8450) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vlogic=3.3"»
  «text (-8000,-8450) 1 7 1 0x1000000 -1 -1 "ï»¿logic level of the PWM into the gate drivers"»
  «text (-12000,-8600) 1 7 1 0x1000000 -1 -1 "ï»¿* controller enable and open-loop duties"»
  «text (-12000,-8750) 1 7 0 0x1000000 -1 -1 "ï»¿.param TEN=1m"»
  «text (-8000,-8750) 1 7 1 0x1000000 -1 -1 "ï»¿controller enable time: open loop before it, closed loop after"»
  «text (-12000,-8900) 1 7 0 0x1000000 -1 -1 "ï»¿.param D0A1=0.5 D0B1=0.5 D0A2=0.5 D0B2=0.5"»
  «text (-8000,-8900) 1 7 1 0x1000000 -1 -1 "ï»¿duties before TEN (leg A / B of converter 1 / 2)"»
  «text (-12000,-9050) 1 7 1 0x1000000 -1 -1 "ï»¿* reference steps"»
  «text (-12000,-9200) 1 7 0 0x1000000 -1 -1 "ï»¿.param VSTEP1=0 VSTEP2=0 TSTEP=10m"»
  «text (-8000,-9200) 1 7 1 0x1000000 -1 -1 "ï»¿voltage-difference references (VM1-VM2, VM2-VM3) stepped at TSTEP"»
  «text (-12000,-9350) 1 7 1 0x1000000 -1 -1 "ï»¿* DLL test inputs"»
  «text (-12000,-9500) 1 7 0 0x1000000 -1 -1 "ï»¿.param KSCALE=0.3"»
  «text (-8000,-9500) 1 7 1 0x1000000 -1 -1 "ï»¿gain scale; 0.3 = firmware boot default (kscale in 7_Pi/pod/params.yaml)"»
  «text (-12000,-9650) 1 7 0 0x1000000 -1 -1 "ï»¿.param MSEL=0"»
  «text (-8000,-9650) 1 7 1 0x1000000 -1 -1 "ï»¿0 = M compiled into the DLL (params.h), 1 = the 100 kHz S9i M, 2 = ctrl_M2.txt"»
  «text (-12000,-9800) 1 7 0 0x1000000 -1 -1 "ï»¿.param FILT=0 FC=2000"»
  «text (-8000,-9800) 1 7 1 0x1000000 -1 -1 "ï»¿0 = first-order IIR at FC Hz; 1..8 = moving average over that many control ticks"»
  «text (-12000,-9950) 1 7 0 0x1000000 -1 -1 "ï»¿.param NOISE=0"»
  «text (-8000,-9950) 1 7 1 0x1000000 -1 -1 "ï»¿sensor noise: 1 = bench level"»
  «text (-12000,-10100) 1 7 0 0x1000000 -1 -1 "ï»¿.param SAMP=1"»
  «text (-8000,-10100) 1 7 1 0x1000000 -1 -1 "ï»¿1 = firmware hall sampling (4 samples per PWM period), 0 = ideal average, 2 = old firmware"»
  «text (-12000,-10250) 1 7 0 0x1000000 -1 -1 "ï»¿.param KBERR=1"»
  «text (-8000,-10250) 1 7 1 0x1000000 -1 -1 "ï»¿B-phase gain error factor"»
  «text (-12000,-10400) 1 7 0 0x1000000 -1 -1 "ï»¿.param VM1SRC=0 VSTRP=0"»
  «text (-8000,-10400) 1 7 1 0x1000000 -1 -1 "ï»¿VM1 source (0 = INA239); VSTRP string-voltage option"»
  «text (-12000,-10550) 1 7 1 0x1000000 -1 -1 "ï»¿* kept from the drawn v3 sheet"»
  «text (-12000,-10700) 1 7 0 0x1000000 -1 -1 "ï»¿.param VT=0.009"»
  «text (-2500,-7750) 1.4 7 1 0x1000000 -1 -1 "ï»¿SIMULATION"»
  «text (-2500,-8000) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 20m"»
  «text (-300,-8000) 1 7 1 0x1000000 -1 -1 "ï»¿the 15 ms shade ramp of V1 / V2 starts inside the window"»
  «text (-2500,-8150) 1 7 0 0x1000000 -1 -1 "ï»¿.culltime = 1n"»
  «text (-2500,-8300) 1 7 0 0x1000000 -1 -1 "ï»¿.plot I(I1)*V(Out)"»
  «text (-2500,-8450) 1 7 1 0x1000000 -1 -1 "ï»¿* .save keeps the .qraw small: every node of the measurements, add what you want to plot"»
  «text (-2500,-8600) 1 7 0 0x1000000 -1 -1 "ï»¿.save V(Out) V(PV2P) V(PV3P) V(T1) V(B1) V(HS_A1) V(HS_B1) V(HS_A2) V(HS_B2) I(I1)"»
  «text (-2500,-8750) 1 7 0 0x1000000 -1 -1 "ï»¿.save V(PWM_AH1) V(PWM_BH1) V(PWM_AH2) V(PWM_BH2) I(V4â€¢XS1) I(V7â€¢XS1) I(V5â€¢XS2) I(V6â€¢XS2)"»
  «text (-2500,-8900) 1 7 0 0x1000000 -1 -1 "ï»¿.save V(DA1â€¢XC) V(DB1â€¢XC) V(DA2â€¢XC) V(DB2â€¢XC) V(STRESSâ€¢XC) V(BETAâ€¢XC) V(RV1â€¢XC) V(RV2â€¢XC)"»
  «text (-2500,-9050) 1 7 1 0x1000000 -1 -1 "ï»¿* functions used inside the sub-sheets (a top-level .func is visible there)"»
  «text (-2500,-9200) 1 7 0 0x1000000 -1 -1 "ï»¿.func hall(cur,gain) = 1.65+gain*cur"»
  «text (-2500,-9350) 1 7 0 0x1000000 -1 -1 "ï»¿.func duty(en,cmd,dflt) = if(en>0.5,cmd,dflt)"»
  «text (-2500,-9500) 1 7 0 0x1000000 -1 -1 "ï»¿.func pwm_top(rmp,dty) = if(time<1n,0,if(rmp<dty-Tdead/Tsw,Vlogic,0))"»
  «text (-2500,-9650) 1 7 0 0x1000000 -1 -1 "ï»¿.func pwm_bot(rmp,dty) = if(time<1n,0,if(rmp>dty,if(rmp<1-Tdead/Tsw,Vlogic,0),0))"»
  «text (-2500,-9800) 1 7 1 0x1000000 -1 -1 "ï»¿  TMCS1126 output: 1.65 V + gain * winding current"»
  «text (-2500,-9950) 1 7 1 0x1000000 -1 -1 "ï»¿  commanded duty: the DLL output when enabled, else the open-loop duty"»
  «text (-2500,-10100) 1 7 1 0x1000000 -1 -1 "ï»¿  top FET on while RAMP < D - Tdead/Tsw (all low at t = 0)"»
  «text (-2500,-10250) 1 7 1 0x1000000 -1 -1 "ï»¿  bottom FET on while D < RAMP < 1 - Tdead/Tsw"»
  «text (-2500,-10400) 1 7 1 0x1000000 -1 -1 "ï»¿* quick check: .tran 1.5m with TEN=0.3m VSTEP2=1 TSTEP=0.8m (meas window 1.3m-1.5m) solves in about 30 s"»
  «text (-2500,-10550) 1 7 1 0x1000000 -1 -1 "ï»¿* usual next move: .step param KSCALE list 0.3 1"»
  «text (7500,-7750) 1.4 7 1 0x1000000 -1 -1 "ï»¿MEASUREMENTS - settled window 18-20 ms of the 20 ms run"»
  «text (7500,-8000) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vd1 AVG V(Out,PV2P)-V(PV2P,PV3P) FROM 18m TO 20m"»
  «text (7500,-8150) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vd2 AVG V(PV2P,PV3P)-V(PV3P) FROM 18m TO 20m"»
  «text (7500,-8300) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ic1 AVG I(V4â€¢XS1)-I(V7â€¢XS1) FROM 18m TO 20m"»
  «text (7500,-8450) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ic2 AVG I(V5â€¢XS2)-I(V6â€¢XS2) FROM 18m TO 20m"»
  «text (7500,-8600) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ish1 AVG I(V4â€¢XS1)+I(V7â€¢XS1) FROM 18m TO 20m"»
  «text (7500,-8750) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ish2 AVG I(V5â€¢XS2)+I(V6â€¢XS2) FROM 18m TO 20m"»
  «text (7500,-8900) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran da1 AVG V(DA1â€¢XC) FROM 18m TO 20m"»
  «text (7500,-9050) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran db1 AVG V(DB1â€¢XC) FROM 18m TO 20m"»
  «text (7500,-9200) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran da2 AVG V(DA2â€¢XC) FROM 18m TO 20m"»
  «text (7500,-9350) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran db2 AVG V(DB2â€¢XC) FROM 18m TO 20m"»
  «text (7500,-9500) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran pout AVG I(I1)*V(Out) FROM 18m TO 20m"»
  «text (7500,-9650) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vout AVG V(Out) FROM 18m TO 20m"»
  «text (7500,-9800) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran iout AVG I(I1) FROM 18m TO 20m"»
  «text (7500,-9950) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran stressmax MAX V(STRESSâ€¢XC)"»
  «text (7500,-10100) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran hsa1 AVG V(HS_A1) FROM 18m TO 20m"»
  «text (7500,-10250) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran hsb1 AVG V(HS_B1) FROM 18m TO 20m"»
  «text (7500,-10400) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran hsa2 AVG V(HS_A2) FROM 18m TO 20m"»
  «text (7500,-10550) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran hsb2 AVG V(HS_B2) FROM 18m TO 20m"»
  «text (7500,-10700) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran pwmah1 AVG V(PWM_AH1) FROM 18m TO 20m"»
  «text (7500,-10850) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran pwmah2 AVG V(PWM_AH2) FROM 18m TO 20m"»
  «text (7500,-11000) 1 7 1 0x1000000 -1 -1 "ï»¿* vd1 / vd2: module voltage differences the controller nulls; ic / ish: circulating / shuffled"»
  «text (7500,-11150) 1 7 1 0x1000000 -1 -1 "ï»¿* inductor currents of each converter; da / db: commanded duties; pout / vout / iout: string power, voltage, current;"»
  «text (7500,-11300) 1 7 1 0x1000000 -1 -1 "ï»¿* stressmax: supervisor peak stress; hs*: hall outputs (1.65 V at zero current); pwmah*: top-FET PWM average"»
»

