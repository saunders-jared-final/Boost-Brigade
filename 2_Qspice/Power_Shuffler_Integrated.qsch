  «wire (9000,-300) (8400,-300) "Out"»
  «wire (9000,-700) (8400,-700) "PV2P"»
  «wire (9000,-1100) (8400,-1100) "PV3P"»
  «wire (9000,-1500) (8400,-1500) "HS_A1"»
  «wire (9000,-1900) (8400,-1900) "HS_B1"»
  «wire (9000,-2300) (8400,-2300) "HS_A2"»
