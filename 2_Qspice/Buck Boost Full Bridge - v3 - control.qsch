  «text (-2500,-8900) 1 7 1 0x1000000 -1 -1 "ï»¿shuffler_ctrl_dll2.dll: INA239 / hall sampling and quantisation, 10 kHz control tick, M from params.h"»
  «text (700,-9400) 1 7 1 0x1000000 -1 -1 "ï»¿Control parameters (edit here):"»
  «text (700,-9600) 1 7 0 0x1000000 -1 -1 "ï»¿.param Tsw=5u Tdead=200n Vlogic=3.3"»
  «text (700,-9750) 1 7 0 0x1000000 -1 -1 "ï»¿.param TEN=1m D0A1=0.5 D0B1=0.5 D0A2=0.5 D0B2=0.5"»
  «text (700,-9900) 1 7 0 0x1000000 -1 -1 "ï»¿.param VSTEP1=0 VSTEP2=0 TSTEP=10m"»
  «text (700,-10050) 1 7 0 0x1000000 -1 -1 "ï»¿.param KSCALE=0.3 MSEL=0 FILT=0 FC=2000 NOISE=0 SAMP=1 KBERR=1 VM1SRC=0 VSTRP=0"»
  «text (700,-10400) 1 7 1 0x1000000 -1 -1 "ï»¿Measurements (settled window of the 20 ms run):"»
  «text (700,-10600) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vd1 AVG V(Out,PV2P)-V(PV2P,PV3P) FROM 18m TO 20m"»
  «text (700,-10750) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran vd2 AVG V(PV2P,PV3P)-V(PV3P) FROM 18m TO 20m"»
  «text (700,-10900) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ic1 AVG I(V4)-I(V7) FROM 18m TO 20m"»
  «text (700,-11050) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ic2 AVG I(V5)-I(V6) FROM 18m TO 20m"»
  «text (700,-11200) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ish1 AVG I(V4)+I(V7) FROM 18m TO 20m"»
  «text (700,-11350) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran ish2 AVG I(V5)+I(V6) FROM 18m TO 20m"»
  «text (700,-11500) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran da1 AVG V(DA1) FROM 18m TO 20m"»
  «text (700,-11650) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran db1 AVG V(DB1) FROM 18m TO 20m"»
  «text (700,-11800) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran da2 AVG V(DA2) FROM 18m TO 20m"»
  «text (700,-11950) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran db2 AVG V(DB2) FROM 18m TO 20m"»
  «text (700,-12100) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran pout AVG I(I1)*V(Out) FROM 18m TO 20m"»
  «text (700,-12250) 1 7 0 0x1000000 -1 -1 "ï»¿.meas tran stressmax MAX V(STRESS)"»
